struct Account
  owner: String
  balance: i64
end

impl Account
  def new(owner: String) -> Self
    Account { owner, balance: 0 }
  end

  def deposit(mut self, amount: i64)
    self.balance += amount
  end

  def status(self) -> Str
    case self.balance
      0 -> "empty"
      b when b < 0 -> "overdrawn"
      _ -> "ok"
    end
  end
end

def main
  accounts = [Account.new("ana"), Account.new("bia")]
  for acc in accounts.iter_mut
    acc.deposit(100)
  end
  rich = accounts.iter.filter do |a|
    threshold = 50
    a.balance > threshold
  end.collect
  for a in rich
    println("#{a.owner} is #{a.status()}")
  end
end
